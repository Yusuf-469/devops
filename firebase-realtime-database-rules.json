{
  "rules": {
    // Chat History - Users can only access their own chat data
    "chatHistory": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['messages', 'timestamp', 'sessionId'])",
        "messages": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "sessionId": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "timestamp": {
          ".validate": "newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // Report Analyzer - Store and retrieve medical reports
    "reports": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['reportData', 'analysis', 'timestamp'])",
        "reportData": {
          ".validate": "newData.hasChildren(['type', 'content', 'metadata'])"
        },
        "analysis": {
          ".validate": "newData.hasChildren(['ai_response', 'confidence', 'recommendations'])"
        },
        "timestamp": {
          ".validate": "newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // Dashboard Analytics - User-specific dashboard data
    "dashboard": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['healthMetrics', 'chatStats', 'lastUpdated'])",
        "healthMetrics": {
          ".validate": "newData.hasChildren(['vitals', 'medications', 'appointments'])"
        },
        "chatStats": {
          ".validate": "newData.hasChildren(['totalChats', 'aiInteractions', 'responseTime'])"
        },
        "lastUpdated": {
          ".validate": "newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // User Profile - Basic user information
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['profile', 'preferences'])",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'createdAt'])"
        },
        "preferences": {
          ".validate": "newData.hasChildren(['theme', 'notifications', 'privacy'])"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // System-wide analytics (admin only - read-only for users)
    "analytics": {
      ".read": "auth != null", // Allow authenticated users to read aggregated data
      ".write": false, // No direct writes to analytics
      "userCount": {
        ".read": "auth != null",
        ".write": false
      },
      "usageStats": {
        ".read": "auth != null",
        ".write": false
      }
    },

    // Emergency contacts and data (encrypted on client side)
    "emergency": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['contacts', 'medicalInfo', 'lastUpdated'])",
        "contacts": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "medicalInfo": {
          ".validate": "newData.hasChildren(['bloodType', 'allergies', 'conditions'])"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // Medication tracking
    "medications": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['current', 'history', 'reminders'])",
        "current": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "history": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "reminders": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // Health tracking data
    "healthTracking": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['vitals', 'symptoms', 'logs'])",
        "vitals": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "symptoms": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "logs": {
          ".validate": "newData.exists() && newData.val() != null"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // App settings and preferences
    "settings": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['ui', 'ai', 'privacy'])",
        "$other": {
          ".validate": false
        }
      }
    }
  }
}