# Frontend Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Frontend Variables (Safe to expose)
# ============================================

# Emergency Numbers
VITE_EMERGENCY_NUMBER=102
VITE_HELP_NUMBER=7903810922

# Firebase Client Configuration (public, safe to expose)
# Get these from Firebase Console → Project Settings → General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================
# Server-side Variables (Vercel Dashboard ONLY)
# NOT exposed to frontend code
# ============================================

# OPENROUTER_API_KEY=your_openrouter_api_key