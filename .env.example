# ============================================
# Frontend Environment Variables (VITE_ prefix required for Vite)
# These are publicly safe - API key is designed to be in frontend
# ============================================

# OpenRouter API Key (required for AI chat)
# Get from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Emergency Numbers (public safety info)
VITE_EMERGENCY_NUMBER=102
VITE_HELP_NUMBER=7903810922

# ============================================
# Backend Environment Variables (Vercel Dashboard only)
# These are server-side secrets - NOT exposed to frontend
# ============================================

# OPENROUTER_API_KEY=sk-or-v1-your-key-here (for serverless functions if needed)